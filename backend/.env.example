# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=UTC
EXCHANGE_TIMEZONE=America/New_York

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
OPERATOR_USERNAME=admin
OPERATOR_PASSWORD=change-me

# --- Database (Neon Postgres) ---
# Neon connection strings normally end with ?sslmode=require - keep that.
# Use the asyncpg driver form: postgresql+asyncpg://...
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST/DBNAME?ssl=require

# --- Broker: Bybit TradFi ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_ENV=demo
# BYBIT_BASE_URL / BYBIT_WS_URL let you point at demo vs live without code changes.
# Verify these against current Bybit TradFi API docs before going live.
BYBIT_BASE_URL=https://api-demo.bybit.com
BYBIT_WS_URL=wss://stream-demo.bybit.com/v5/private
BYBIT_RECV_WINDOW=5000

# --- Market Data: Alpaca ---
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_DATA_BASE_URL=https://data.alpaca.markets
ALPACA_STREAM_URL=wss://stream.data.alpaca.markets/v2/iex

# --- Risk Defaults (Semi Aggressive profile) ---
RISK_PER_TRADE_PCT=1.25
DAILY_LOSS_LIMIT_PCT=4.0
MAX_CONCURRENT_POSITIONS=4
MAX_PORTFOLIO_EXPOSURE_PCT=80.0
MAX_STRATEGY_ALLOCATION_PCT=50.0
MAX_SPREAD_PCT=0.15

# --- CORS ---
DASHBOARD_ORIGIN=http://localhost:3000
